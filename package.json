{
  "name": "mytinerary",
  "version": "1.0.0",
  "description": "travel app",
  "main": "server.js",
  "scripts": {
    "test": "cd client && npm test -- --watchAll=false",
    "client": "cd client && npm start",
    "server": "nodemon server.js",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix client && npm run build --prefix client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezequiel-pereira/mytinerary.git"
  },
  "keywords": [
    "travel"
  ],
  "author": "Ezequiel Pereira",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ezequiel-pereira/mytinerary/issues"
  },
  "homepage": "https://github.com/ezequiel-pereira/mytinerary#readme",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
